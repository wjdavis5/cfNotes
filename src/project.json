{
  "name": "cfnote",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "serve-all": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": true,
        "commands": [
          {
            "command": "nx serve web"
          },
          {
            "command": "nx serve api"
          }
        ]
      }
    }
  }
} 